<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#B04D8FEA" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#AAFFFFFF" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B0558FD8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#88FFFFFF" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8A161B22" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
