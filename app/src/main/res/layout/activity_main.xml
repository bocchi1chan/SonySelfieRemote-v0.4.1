<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen live view. Controls float above it. -->
    <FrameLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <com.sonyselfieremote.LiveViewSurface
            android:id="@+id/liveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/liveProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="96sp"
            android:textStyle="bold"
            android:shadowColor="#DD000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="10" />
    </FrameLayout>

    <!-- Safe-area overlay. Live view can extend behind the system bars. -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/topStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connectionToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/floating_button"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="连接"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/floating_panel"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="请先连接 A7R II 的 Wi‑Fi"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/hideControlsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/floating_button"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="隐藏"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/connectionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/floating_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <EditText
                    android:id="@+id/cameraIpEdit"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/floating_input"
                    android:hint="自动查找 / 192.168.122.1:8080"
                    android:inputType="textUri"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#A8FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/floating_button"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="连接相机"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/quickControlsBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/rotateButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/floating_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="旋转"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <ToggleButton
                        android:id="@+id/fillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/floating_toggle"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textOff="完整画面"
                        android:textOn="铺满画面"
                        android:textColor="#FFFFFF" />

                    <ToggleButton
                        android:id="@+id/mirrorButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/floating_toggle"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textOff="镜像关"
                        android:textOn="镜像开"
                        android:textColor="#FFFFFF" />

                    <ToggleButton
                        android:id="@+id/gridButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/floating_toggle"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textOff="三分线关"
                        android:textOn="三分线开"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/focusButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/floating_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="AF"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/selfieSettingsToggleButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/floating_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="自拍设置"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <ToggleButton
                        android:id="@+id/advancedToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/floating_toggle"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:textOff="专业控制"
                        android:textOn="专业控制开"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/advancedPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/floating_panel"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模式" android:textColor="#FFFFFF" />
                    <Spinner android:id="@+id/modeSpinner" android:layout_width="118dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/floating_input" android:popupBackground="#F0191D24" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="快门" android:textColor="#FFFFFF" />
                    <Spinner android:id="@+id/shutterSpinner" android:layout_width="118dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/floating_input" android:popupBackground="#F0191D24" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="光圈" android:textColor="#FFFFFF" />
                    <Spinner android:id="@+id/apertureSpinner" android:layout_width="98dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/floating_input" android:popupBackground="#F0191D24" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="ISO" android:textColor="#FFFFFF" />
                    <Spinner android:id="@+id/isoSpinner" android:layout_width="105dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/floating_input" android:popupBackground="#F0191D24" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="EV" android:textColor="#FFFFFF" />
                    <Spinner android:id="@+id/evSpinner" android:layout_width="88dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/floating_input" android:popupBackground="#F0191D24" />
                    <ToggleButton android:id="@+id/histButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/floating_toggle" android:minHeight="0dp" android:minWidth="0dp" android:textOff="直方图关" android:textOn="直方图开" android:textColor="#FFFFFF" />
                    <ToggleButton android:id="@+id/zebraButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="5dp" android:background="@drawable/floating_toggle" android:minHeight="0dp" android:minWidth="0dp" android:textOff="斑马纹关" android:textOn="斑马纹开" android:textColor="#FFFFFF" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/selfieSettingsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/floating_panel"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="5dp"
                    android:text="自拍设置"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/timerSpinner"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/floating_input"
                        android:popupBackground="#F0191D24" />

                    <Spinner
                        android:id="@+id/burstSpinner"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/floating_input"
                        android:popupBackground="#F0191D24" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/intervalSpinner"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/floating_input"
                        android:popupBackground="#F0191D24" />

                    <Spinner
                        android:id="@+id/previewSpinner"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/floating_input"
                        android:popupBackground="#F0191D24" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/galleryPanel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/floating_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="最近"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/galleryStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/selfieSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/floating_panel"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="15秒 · 3张 · 间隔1秒 · 回看5秒"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/shutterButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@drawable/floating_primary"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="开始自拍"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/showControlsButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/floating_button"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="显示控件"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <!-- Full-screen post-shot review. This sits above every control. -->
    <FrameLayout
        android:id="@+id/previewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0000000"
        android:clickable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/previewMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="94dp"
            android:contentDescription="刚拍摄的照片"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/previewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/floating_panel"
            android:padding="8dp"
            android:text="刚刚拍摄"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/previewCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/floating_button"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="返回取景"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_gravity="bottom"
            android:background="#B0000000"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/previewThumbStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </FrameLayout>
</FrameLayout>
