<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/cameraIpEdit"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:inputType="textUri"
                android:hint="自动查找（如 192.168.122.1）"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:backgroundTint="#6AAEFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:text="连接相机" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:text="请先连接 A7R II 的 Wi‑Fi，然后点“连接相机”"
            android:textColor="#D0D0D0"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111">

        <com.sonyselfieremote.LiveViewSurface
            android:id="@+id/liveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/liveProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="92sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8" />

        <FrameLayout
            android:id="@+id/previewOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F0000000"
            android:visibility="gone"
            android:clickable="true">

            <ImageView
                android:id="@+id/previewMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="92dp"
                android:scaleType="fitCenter"
                android:contentDescription="刚拍摄的照片" />

            <TextView
                android:id="@+id/previewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:padding="8dp"
                android:background="#99000000"
                android:text="刚刚拍摄"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/previewCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:text="返回取景" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_gravity="bottom"
                android:background="#B0000000"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/previewThumbStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </FrameLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/rotateButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="旋转 +90°" />
            <ToggleButton android:id="@+id/mirrorButton" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="镜像：开" android:textOff="镜像：关" />
            <ToggleButton android:id="@+id/gridButton" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="三分线：开" android:textOff="三分线：关" />
            <Button android:id="@+id/focusButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="AF" />
            <ToggleButton android:id="@+id/advancedToggle" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="专业控制：开" android:textOff="专业控制：关" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/advancedPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模式" android:textColor="#FFFFFF" android:paddingEnd="4dp" />
            <Spinner android:id="@+id/modeSpinner" android:layout_width="120dp" android:layout_height="46dp" android:popupBackground="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="快门" android:textColor="#FFFFFF" android:paddingStart="8dp" android:paddingEnd="4dp" />
            <Spinner android:id="@+id/shutterSpinner" android:layout_width="120dp" android:layout_height="46dp" android:popupBackground="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="光圈" android:textColor="#FFFFFF" android:paddingStart="8dp" android:paddingEnd="4dp" />
            <Spinner android:id="@+id/apertureSpinner" android:layout_width="100dp" android:layout_height="46dp" android:popupBackground="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ISO" android:textColor="#FFFFFF" android:paddingStart="8dp" android:paddingEnd="4dp" />
            <Spinner android:id="@+id/isoSpinner" android:layout_width="110dp" android:layout_height="46dp" android:popupBackground="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EV" android:textColor="#FFFFFF" android:paddingStart="8dp" android:paddingEnd="4dp" />
            <Spinner android:id="@+id/evSpinner" android:layout_width="90dp" android:layout_height="46dp" android:popupBackground="#FFFFFF" />
            <ToggleButton android:id="@+id/histButton" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="直方图：开" android:textOff="直方图：关" />
            <ToggleButton android:id="@+id/zebraButton" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="斑马纹：开" android:textOff="斑马纹：关" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自拍设置"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Spinner android:id="@+id/timerSpinner" android:layout_width="150dp" android:layout_height="48dp" />
            <Spinner android:id="@+id/burstSpinner" android:layout_width="130dp" android:layout_height="48dp" />
            <Spinner android:id="@+id/intervalSpinner" android:layout_width="145dp" android:layout_height="48dp" />
            <Spinner android:id="@+id/previewSpinner" android:layout_width="170dp" android:layout_height="48dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/shutterButton"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:text="开始自拍"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最近拍摄（点击可用系统相册查看）"
        android:textColor="#BDBDBD"
        android:textSize="12sp"
        android:paddingTop="3dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:scrollbars="none"
        android:background="#111111">
        <LinearLayout
            android:id="@+id/galleryStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>
</LinearLayout>
